# Production configuration for project buildclose-d4399.
#
# This file is COMMITTED on purpose: it holds no secrets, only non-sensitive
# origins and model selection. Secrets (OPENAI_API_KEY, SESSION_SECRET,
# STRIPE_*) are never stored here — they are set with
# `firebase functions:secrets:set` and bound in src/index.ts.
#
# Firebase loads `.env` < `.env.<projectId>` < `.env.local`, so local
# development on the emulator keeps its localhost origins from .env.local and
# never accidentally inherits the production allowlist.
#
# Hostname plan (three application hosts + one client-facing proposal host):
#   buildclose.app         commercial site
#   app.buildclose.app     customer dashboard (staff-facing)
#   agent.buildclose.app   AI assistant infrastructure: serves widget.js AND the
#                          framed chat app, and is the only API caller
#   agency-proposals.com   client-facing proposal hosting (embed origin)
#
# Requirement 3: the assistant surface must not share an origin with the
# administrative dashboard. `agent.` vs `app.` satisfies that; consolidating the
# widget loader and the chat app onto one hostname keeps the trusted-origin list
# short and avoids a fourth DNS record for a 5 KB script.
CHAT_ORIGIN=https://agent.buildclose.app
DASHBOARD_ORIGIN=https://app.buildclose.app
# Where proposal pages live. This is the DEFAULT authorized host for embeds; each
# access token also carries its own `allowedOrigins`, so a future customer on
# their own domain is pinned per proposal without a redeploy.
EMBED_ORIGIN=https://agency-proposals.com
APP_BASE_URL=https://buildclose.app

# Model selection is configuration, not a secret, so it is versioned here.
# The version identifier is stamped onto every aiUsage record by pricing.ts.
OPENAI_MODEL=gpt-6.1-sol
