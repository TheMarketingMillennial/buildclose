# BuildClose Cloud Functions — environment variables
#
# Template only. Contains NO credentials — only origins and model selection.
# Safe to commit.
#
# HOW THIS IS CONSUMED
# Firebase loads, in increasing precedence:
#   .env  <  .env.<projectId>  <  .env.local
#
# The real file for this project is `functions/.env.buildclose-d4399`, which IS
# committed because Firebase reads it at deploy time and it holds nothing
# secret. Copy this template to that name to recreate it:
#
#   cp functions/.env.example functions/.env.buildclose-d4399
#
# ============================================================================
# SECRETS DO NOT BELONG IN THIS FILE
# ============================================================================
# These five are set with `firebase functions:secrets:set <NAME>`, which writes
# them to Google Secret Manager, and are bound per-function in
# functions/src/index.ts:
#
#   OPENAI_API_KEY          bound to: api
#   SESSION_SECRET          bound to: api
#   SETUP_CODE              bound to: bootstrapCompany   (destroy after onboarding)
#   STRIPE_SECRET_KEY       bound to: createCheckoutSession, stripeWebhook
#   STRIPE_WEBHOOK_SECRET   bound to: stripeWebhook
#
# A secret that is read in code but NOT declared in that binding list arrives as
# `undefined` at runtime. That has already happened once in this codebase, which
# is why the list is explicit and lives next to the function definitions.
#
# ============================================================================
# PUBLIC CONFIGURATION
# ============================================================================

# The ONLY origin allowed to call the prospect API from a browser.
# Changing this to a value no real origin matches instantly CORS-blocks every
# browser call — a blunt but immediate emergency stop.
CHAT_ORIGIN=https://agent.buildclose.app

DASHBOARD_ORIGIN=https://app.buildclose.app

# Default authorised host for embedded proposal pages. Each access token also
# carries its own allowedOrigins, so a customer on their own domain is pinned
# per proposal without a redeploy.
EMBED_ORIGIN=https://agency-proposals.com

APP_BASE_URL=https://buildclose.app

# Must name a model your OpenAI account can actually access, AND one present in
# functions/src/lib/pricing.ts — otherwise cost accounting for that model has no
# price row. A wrong value does NOT fail at deploy time; it fails on the first
# chat request.
OPENAI_MODEL=gpt-6.1-sol

# Storage bucket for acceptance-evidence images — the only binary artefact this
# application stores. Newer projects use <project>.firebasestorage.app, NOT the
# legacy <project>.appspot.com. If unset, the code falls back to
# <GCLOUD_PROJECT>.appspot.com, which is the wrong domain for this project and
# produces download URLs pointing at a bucket that does not exist.
STORAGE_BUCKET=buildclose-d4399.firebasestorage.app

# ============================================================================
# LOCAL DEVELOPMENT ONLY — never in a deployed configuration
# ============================================================================
# These belong in the gitignored functions/.env.local, pointing at the emulator
# project `buildclose-dev`. NEVER point local development at buildclose-d4399.
#
# GCLOUD_PROJECT=buildclose-dev
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FUNCTIONS_EMULATOR=true
# SETUP_CODE=<any local throwaway value, in .secret.local>
