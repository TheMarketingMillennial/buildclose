# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
functions/lib/
apps/*/dist/

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log
.firebaserc.local

# secrets — NEVER commit
.env
.env.*
!.env.example
# Project-scoped config that deliberately carries NO secrets (origins, model name).
# Committed because Firebase reads it at deploy time. Never add a credential here.
!functions/.env.buildclose-d4399
# The dashboard's environment is NOT committed. It carries the Firebase web API
# key, which GitHub secret scanning reports as a "Google API Key". That key is a
# public client identifier rather than a credential, but committing it on purpose
# means permanently tolerating a standing alert, and the first real credential
# added next to it would hide inside that noise.
#
# Configuration now comes from Netlify environment variables (deployed) or from
# the gitignored `.env.local` (local development). `apps/dashboard/.env.example`
# documents every variable with placeholders.
#
# Explicit negations for the examples, so a future `.env*` rule change cannot
# silently drop the only documentation of the required variables.
!apps/dashboard/.env.example
!apps/agent/.env.example
!apps/proposals/.env.example
!functions/.env.example
*.pem
*.key
serviceAccount*.json
service-account*.json
!serviceAccount.example.json
functions/.secret.local
.secret.local

# netlify
.netlify/

# generated at deploy time from environment variables (never commit)
apps/*/config.js

# os / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

