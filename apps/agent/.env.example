# BuildClose agent site (agent.buildclose.app) — environment variables
#
# Template only. No real values. Safe to commit.
#
# Netlify site: buildclose-agent · Base directory: apps/agent
# Set these in Site configuration → Environment variables.
#
# There is NO credential here. The widget loader carries no secret: the prospect
# access token is supplied by the customer's own HTML attribute and verified
# server-side on every call.

FIREBASE_PROJECT_ID=buildclose-d4399
FUNCTIONS_REGION=us-central1

# OPTIONAL overrides — defaults are derived from the two values above and are
# already production-correct.

# Absolute URL of the prospect API. The exported function is named `api` and its
# Express router also mounts under /api, so the chat client appends /api/<route>
# to this base — the double segment is intentional.
# API_BASE=https://us-central1-buildclose-d4399.cloudfunctions.net/api

# CSP frame-ancestors for the framed chat app.
# Defaults to `https:` — every real embed is an https proposal page.
# NEVER set this to `*`: the CSP is the only thing preventing an arbitrary site
# from framing the assistant invisibly over its own click targets.
# EMBED_FRAME_ANCESTORS=https:
