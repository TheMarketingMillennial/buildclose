# Production configuration for the BuildClose dashboard (project buildclose-d4399).
#
# This file is COMMITTED on purpose, exactly like functions/.env.buildclose-d4399.
# Firebase web configuration is not a secret: Google designs it to ship inside the
# browser bundle. Anyone who opens app.buildclose.app can read these values in
# config.js. The actual security boundary is the default-deny Firestore rules plus
# the custom-claims check inside every callable — never the presence of this file.
#
# Do NOT add a credential here. There is no place in this file for one: the
# dashboard holds no server secret and never calls OpenAI or Stripe directly.

FIREBASE_PROJECT_ID=buildclose-d4399
FIREBASE_API_KEY=AIzaSyBKUWWTyENnUHyCbK4Iq0DeJ7h19GoQwPU
FIREBASE_APP_ID=1:761268855407:web:82c27b93240836a18da39a
FIREBASE_AUTH_DOMAIN=buildclose-d4399.firebaseapp.com
FIREBASE_STORAGE_BUCKET=buildclose-d4399.firebasestorage.app

# Deliberately NOT wired:
#   FIREBASE_MEASUREMENT_ID (G-4QLQMTH09E)
#     Activating it means loading gtag.js from a third party. That would force the
#     dashboard CSP off `script-src 'self'` and put an analytics tracker on the one
#     surface that renders tenant-scoped proposal and revenue data. If analytics is
#     ever wanted here, it should be first-party and reviewed as a privacy change,
#     not switched on by pasting a measurement ID into a build file.
#   FIREBASE_MESSAGING_SENDER_ID
#     No Cloud Messaging in this application; nothing to send to.

# Non-secret runtime origins. Netlify sets these per site; the defaults below match
# the documented hostname plan if they are absent.
DASHBOARD_ORIGIN=https://app.buildclose.app
AGENT_ORIGIN=https://agent.buildclose.app
EMBED_ORIGIN=https://agency-proposals.com
