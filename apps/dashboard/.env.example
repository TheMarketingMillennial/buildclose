# BuildClose dashboard — required environment variables
#
# ============================================================================
# WHERE THESE VALUES COME FROM
# ============================================================================
# This file is a TEMPLATE. It contains no real values and is safe to commit.
# Copy it and fill in your own values:
#
#   cp apps/dashboard/.env.example apps/dashboard/.env.local   # local dev only
#
# On Netlify, do NOT create a .env file — set these in
#   Site configuration → Environment variables
# and the build step picks them up. Netlify env vars take precedence over any
# file, so a deploy cannot accidentally inherit a developer's local settings.
#
# .env.local is gitignored. Never commit it.
#
# ============================================================================
# ARE THESE SECRETS?
# ============================================================================
# No. Every value below is PUBLIC configuration. Google designs Firebase web
# config to ship inside the browser bundle: anyone who loads the dashboard can
# read all of it from config.js. The security boundary is the default-deny
# Firestore/Storage rules plus the custom-claims check inside every Cloud
# Function callable — never the secrecy of these values.
#
# They are still kept out of git. Not because they are credentials, but because
# committing an `AIzaSy…` string on purpose means permanently tolerating a
# secret-scanning alert, and the first real credential added next to it would
# hide inside that noise.
#
# Where to find them: Firebase console → Project settings → Your apps →
# the Web app for this project → "SDK setup and configuration" → Config.
#
# ============================================================================
# REQUIRED — the build FAILS if any of these is missing
# ============================================================================

FIREBASE_PROJECT_ID=buildclose-d4399

# Public client identifier. Not a credential. Looks like AIzaSy... (39 chars).
FIREBASE_API_KEY=AIzaSy_REPLACE_WITH_YOUR_WEB_API_KEY

# Web app id, of the form 1:<project-number>:web:<hash>
FIREBASE_APP_ID=1:REPLACE_WITH_PROJECT_NUMBER:web:REPLACE_WITH_APP_HASH

# Newer projects use <project>.firebasestorage.app, not the legacy
# <project>.appspot.com. Getting this wrong breaks download URLs for
# acceptance-evidence images, which is the only binary artefact stored.
FIREBASE_STORAGE_BUCKET=buildclose-d4399.firebasestorage.app

# ============================================================================
# RECOMMENDED
# ============================================================================

# Defaults to <FIREBASE_PROJECT_ID>.firebaseapp.com when absent.
FIREBASE_AUTH_DOMAIN=buildclose-d4399.firebaseapp.com

# ============================================================================
# OPTIONAL overrides — the defaults below are already production-correct,
# so you normally set none of them. Shown for completeness.
# ============================================================================

# FUNCTIONS_REGION=us-central1
# FUNCTIONS_BASE=https://us-central1-buildclose-d4399.cloudfunctions.net
# AUTH_BASE=https://identitytoolkit.googleapis.com
# TOKEN_BASE=https://securetoken.googleapis.com
# AGENT_ORIGIN=https://agent.buildclose.app

# ============================================================================
# DELIBERATELY NOT SUPPORTED — do not add these
# ============================================================================
# FIREBASE_MEASUREMENT_ID
#   Enabling it loads gtag.js from a third party. That forces the dashboard CSP
#   off `script-src 'self'` and puts an analytics tracker on the one surface
#   that renders tenant-scoped proposal and revenue data. If product analytics
#   is ever wanted here it should be first-party and reviewed as a privacy
#   change, not switched on by pasting an id into a build file.
#
# FIREBASE_MESSAGING_SENDER_ID
#   No Cloud Messaging in this application. Nothing to send to.
