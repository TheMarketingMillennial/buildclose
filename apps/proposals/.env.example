# BuildClose proposals site (agency-proposals.com) — environment variables
#
# Template only. Safe to commit — the placeholder below is not a real token.
#
# Netlify site: buildclose-proposals · Base directory: apps/proposals
#
# ⚠ ONE CONFIDENTIAL VALUE HERE. PROPOSAL_TOKEN is a real credential: it grants
#   one prospect's assistant access to one proposal. Treat it like a password.
#   Never commit it, never paste it into chat, never put it in a screenshot.
#
# Set it in Netlify → Site configuration → Environment variables, not in a file.
# Netlify environment variables are write-only in the UI after saving, and the
# build consumes the value without printing it.

# The prospect access token, minted with the `mintAccessToken` callable as a
# company_admin. Format: bc_pk_ followed by 20+ URL-safe characters.
# The build FAILS if this is missing or malformed, so a broken token cannot
# silently ship a page showing a literal placeholder to a prospect.
#
# Only its SHA-256 hash is stored server-side; the plaintext is shown once at
# mint time and cannot be recovered. If you lose it, revoke the token and mint
# another. Rotating it is an environment-variable change plus a redeploy — the
# token is injected at build time precisely so it never enters git history.
PROPOSAL_TOKEN=bc_pk_REPLACE_WITH_YOUR_MINTED_TOKEN

# Public. The assistant origin. Goes into both the CSP and the widget tag,
# which is why they are generated from the same variable and cannot drift.
AGENT_ORIGIN=https://agent.buildclose.app

# OPTIONAL
# PAYMENT_URL=https://checkout.stripe.com/c/pay/REPLACE_ME
#   https only. The payment button is hidden entirely when this is unset.
# PROPOSAL_SLUG=abrica
#   Output filename. Defaults to "abrica".
# ALLOW_PAYMENT_IFRAME=false
#   "true" also permits Stripe in the CSP frame-src directive.
