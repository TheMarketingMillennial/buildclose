/**
 * Security headers for the static frontends (Netlify).
 *
 * These matter more than they look. The chat app must be framable ONLY by sites
 * we control plus customer pages that use the widget — so it cannot use a blanket
 * DENY, but it must never be wildcard-framable either. The widget itself loads the
 * chat app inside a sandboxed iframe, which is a different relationship from being
 * framed by an arbitrary site.
 *
 * In production, `frame-ancestors` for the chat app is intentionally broad on the
 * /embed path because the whole product is "be embedded by the customer". The
 * compensating controls are that the embed surface holds no authenticated session,
 * carries no cookies (session lives in memory only), and every request is
 * authorised by a proposal token rather than by ambient credentials.
 */
export const headers = `/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()


# The widget must be loadable cross-origin by any customer site.
/widget.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300


# The chat app is designed to be framed by the widget.
/embed
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://*.run.app; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors https: http://localhost:*; base-uri 'none'; form-action 'self'
  Cache-Control: no-store


# The dashboard is never framed — a clickjacking attempt must fail outright.
/app/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://*.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.run.app; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'
  X-Frame-Options: DENY
  Cache-Control: no-store
`;
