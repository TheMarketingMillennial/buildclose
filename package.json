{
  "name": "buildclose",
  "version": "0.1.0",
  "private": true,
  "description": "BuildClose — AI post-proposal sales automation. Build the proposal. Close the deal.",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "emu": "firebase emulators:start --only auth,firestore,storage,functions",
    "emu:seed": "npm run build:functions && node seed/run.mjs",
    "build:functions": "npm --workspace functions run build",
    "test": "node --test tests/",
    "test:security": "node --test tests/security.test.mjs",
    "lint": "npm --workspace functions run typecheck"
  },
  "devDependencies": {
    "firebase-tools": "^15.37.0"
  },
  "engines": {
    "node": ">=20"
  }
}
